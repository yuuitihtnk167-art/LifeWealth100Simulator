{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-local",
      "type": "shell",
      "command": "py",
      "args": ["-m", "http.server", "8080"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "Serving HTTP on"
        }
      }
    }
  ]
}
